--now we want to create new array fro this daily_aggregate, and 
--then we will have to fill backwards essentially from that date so added event_date in daily_aggregate selection

insert into array_metrics
with daily_aggregate as(
select 
	user_id, 
	date(event_time) as date, -- fill backwards from this date
	count(1) as num_site_hits
from events
where 
date(event_time) = date('2023-01-03') --we are doing this for month of jan and thats how we gonna build up this array
and user_id is not null
group by user_id,date(event_time)
),

yesterday_array as(
	select *
	from array_metrics --new table which is empty at start
	where month_start = date('2023-01-01')
)

select 
coalesce(da.user_id,ya.user_id) as user_id,
coalesce(ya.month_start,date_trunc('month',da.date)) as month_start,
'site_hits' as metric_name,
--to build arrey, in 1st case when yesterday arraynis completly empty then we know all users are on other side (in daily agg table)
case when ya.metric_array is not null then
		ya.metric_array || array[coalesce(da.num_site_hits,0)]
	 when ya.metric_array is null
	 	then array_fill(0,array[coalesce(date-date(date_trunc('month',date)),0)])
		 ||array[coalesce(da.num_site_hits,0)]
	end as metric_array
from daily_aggregate da full outer join yesterday_array ya on da.user_id = ya.user_id
on conflict(user_id,month_start,metric_name)
do 
  update set metric_array = excluded.metric_array;

