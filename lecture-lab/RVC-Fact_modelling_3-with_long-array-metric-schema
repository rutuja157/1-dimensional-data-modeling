 --how to do the aggreation of this so that we can do the aggragate, we can do it with metric name and we can 
--group on metric name , also you can join on userid and bring on other dimentions
--we have 3 days of data and we want to aggregate this and what we want back here is 
--dimentional analysis on 3 days
select 
	metric_name,month_start,
	array[sum(metric_array[1]),
	sum(metric_array[2]),
	sum(metric_array[3])] as summed_array
from array_metrics
group by metric_name,month_start

--and then we can unnest

select 
	metric_name,month_start,
	unnest(array[sum(metric_array[1]),
	sum(metric_array[2]),
	sum(metric_array[3])])
from array_metrics
group by metric_name,month_start

