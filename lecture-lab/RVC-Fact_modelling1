on t.team_id = gd.dim_team_id

select * from fct_game_details
-- lets find the player in the game who like doesnt didnt bailed out in most games 

select dim_player_name ,
dim_is_playing_at_home,
count(1) as num_games,
sum(m_pts) as total_points,
count(case when dim_not_with_team then 1 end) as bailed_num, --missed games
cast(count(case when dim_not_with_team then 1 end) as real)/ count(1) as bail_percentage
from fct_game_details
group by 1,2
order by bail_percentage desc

