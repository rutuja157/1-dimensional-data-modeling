--select * from placeholder_ints

place_holder_ints as (
select 
	dates_active @> array[date(series_date)],
    date- date(series_date) ,
	case when dates_active @> array[date(series_date)]
	then cast(POW(2,32- (date- date(series_date))) as bigint) --convert all dates to integer values that are powers of 2
	else 0
	end as place_holder_int_value
	,
	*
from users cross join series
-- where user_id = '406876712821807740' 
)
--to find monthly daily active users we can sum up the place_holder_int_value
-- and then convert it to bit(32) and then use bitwise operations to find out
-- if the user is active in the last 30 days, last 7 days or last 1 day
-- we can use bitwise operations to find out if the user is active in the last 30 days, last 7 days or last 1 day

select user_id,
		cast(cast(sum(place_holder_int_value) as bigint) as bit(32)),
		bit_count(cast(cast(sum(place_holder_int_value) as bigint) as bit(32))) >0  as dim_is_monthly_active,
		bit_count(cast('11111110000000000000000000000000' as BIT(32)) &
		    cast(cast(sum(place_holder_int_value) as bigint) as bit(32))) > 0 as dim_as_weekly_active,
		bit_count(cast('10000000000000000000000000000000' as BIT(32)) &
		    cast(cast(sum(place_holder_int_value) as bigint) as bit(32))) > 0 as dim_as_daily_active	
from place_holder_ints
group by user_id

